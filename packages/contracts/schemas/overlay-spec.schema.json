{
  "$defs": {
    "CorrectionStrap": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "const": "correction_strap",
          "title": "Template",
          "type": "string"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "template",
        "text"
      ],
      "title": "CorrectionStrap",
      "type": "object"
    },
    "Disclosure": {
      "additionalProperties": false,
      "description": "How AI involvement is shown on an item: the label (rendered by code, never by a model).",
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "mode": {
          "enum": [
            "label-all",
            "label-unless-approved",
            "eu-strict"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ai_generated",
            "ai_assisted_reviewed",
            "data"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "mode",
        "reason"
      ],
      "title": "Disclosure",
      "type": "object"
    },
    "LowerThird": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "line": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Line",
          "type": "string"
        },
        "template": {
          "const": "lower_third",
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template",
        "headline",
        "line"
      ],
      "title": "LowerThird",
      "type": "object"
    },
    "MatchClock": {
      "additionalProperties": false,
      "description": "Elapsed match time within a period, as shown on a broadcast clock (`67:12`).",
      "properties": {
        "minute": {
          "maximum": 104,
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "title": "Period",
          "type": "integer"
        },
        "second": {
          "maximum": 59,
          "minimum": 0,
          "title": "Second",
          "type": "integer"
        }
      },
      "required": [
        "period",
        "minute",
        "second"
      ],
      "title": "MatchClock",
      "type": "object"
    },
    "ScoreBug": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "pattern": "^[A-Z]{3}$",
          "title": "Away",
          "type": "string"
        },
        "clock": {
          "maxLength": 8,
          "minLength": 1,
          "title": "Clock",
          "type": "string"
        },
        "home": {
          "pattern": "^[A-Z]{3}$",
          "title": "Home",
          "type": "string"
        },
        "score": {
          "maxLength": 7,
          "minLength": 1,
          "title": "Score",
          "type": "string"
        },
        "template": {
          "const": "score_bug",
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template",
        "home",
        "away",
        "score",
        "clock"
      ],
      "title": "ScoreBug",
      "type": "object"
    },
    "StatCard": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/StatRow"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "template": {
          "const": "stat_card",
          "title": "Template",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "template",
        "title",
        "rows"
      ],
      "title": "StatCard",
      "type": "object"
    },
    "StatRow": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "StatRow",
      "type": "object"
    }
  },
  "$id": "https://github.com/saguarocloud/fourth-official/schemas/overlay-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "discriminator": {
        "mapping": {
          "correction_strap": "#/$defs/CorrectionStrap",
          "lower_third": "#/$defs/LowerThird",
          "score_bug": "#/$defs/ScoreBug",
          "stat_card": "#/$defs/StatCard"
        },
        "propertyName": "template"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LowerThird"
        },
        {
          "$ref": "#/$defs/StatCard"
        },
        {
          "$ref": "#/$defs/CorrectionStrap"
        },
        {
          "$ref": "#/$defs/ScoreBug"
        }
      ],
      "title": "Content"
    },
    "disclosure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Disclosure"
        },
        {
          "type": "null"
        }
      ]
    },
    "inAt": {
      "$ref": "#/$defs/MatchClock"
    },
    "itemId": {
      "maxLength": 128,
      "pattern": "^it-[a-z]+(-[a-z]+)*-[A-Za-z0-9_-]{1,100}$",
      "title": "Itemid",
      "type": "string"
    },
    "locale": {
      "enum": [
        "en-GB",
        "es-MX",
        "de-DE"
      ],
      "title": "Locale",
      "type": "string"
    },
    "outAt": {
      "$ref": "#/$defs/MatchClock"
    },
    "priority": {
      "maximum": 9,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "provenanceUrl": {
      "anyOf": [
        {
          "maxLength": 300,
          "pattern": "^https://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/?#=&%+-]*)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provenanceurl"
    },
    "supersedes": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^it-[a-z]+(-[a-z]+)*-[A-Za-z0-9_-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes"
    },
    "tenantId": {
      "enum": [
        "northlight-sport",
        "tribuna-austral",
        "rheinblick-sport"
      ],
      "title": "Tenantid",
      "type": "string"
    },
    "version": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "itemId",
    "tenantId",
    "locale",
    "inAt",
    "outAt",
    "priority",
    "content",
    "disclosure",
    "provenanceUrl",
    "version",
    "supersedes"
  ],
  "title": "OverlaySpec",
  "type": "object"
}
