{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "anyOf": [
            {
              "pattern": "^cl-[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Claimid"
        },
        "code": {
          "enum": [
            "MOMENT_MISMATCH",
            "MALFORMED_INSIGHT",
            "UNSUPPORTED_CHARACTER",
            "BARE_NUMBER",
            "RAW_NAME",
            "UNVERIFIED_NAME",
            "UNKNOWN_WORD",
            "FUTURE_WORDING",
            "UNKNOWN_PLAYER",
            "UNKNOWN_CLUB",
            "PLAYER_NOT_IN_EVIDENCE",
            "MINUTE_NOT_IN_EVIDENCE",
            "SNAPSHOT_NOT_FOUND",
            "UNDEFINED_VALUE",
            "EVIDENCE_NOT_FOUND",
            "FUTURE_EVIDENCE",
            "FUTURE_MINUTE",
            "VOIDED_EVIDENCE",
            "SUPERSEDED_EVIDENCE",
            "CLAIMS_CHANGED",
            "REFERENCES_CHANGED",
            "BLOCKED_TOPIC",
            "TOO_LONG"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "claimId",
        "code",
        "detail"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "$id": "https://github.com/saguarocloud/fourth-official/schemas/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 64,
      "title": "Findings",
      "type": "array"
    },
    "insightId": {
      "maxLength": 72,
      "pattern": "^in-m[0-9]{1,12}-",
      "title": "Insightid",
      "type": "string"
    },
    "matchId": {
      "pattern": "^m[0-9]{1,12}$",
      "title": "Matchid",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    }
  },
  "required": [
    "insightId",
    "matchId",
    "passed",
    "findings"
  ],
  "title": "Verdict",
  "type": "object"
}
