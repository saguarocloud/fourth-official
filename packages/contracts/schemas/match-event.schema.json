    "CardEvent": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "enum": [
            "yellow",
            "second_yellow",
            "red"
          ],
          "title": "Card",
          "type": "string"
        },
        "clock": {
          "$ref": "#/$defs/MatchClock"
        },
        "eventId": {
          "pattern": "^m\\d+-e\\d{4,}$",
          "title": "Eventid",
          "type": "string"
        },
        "foulEventId": {
          "anyOf": [
            {
              "pattern": "^m\\d+-e\\d{4,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fouleventid"
        },
        "matchId": {
          "pattern": "^m\\d+$",
          "title": "Matchid",
          "type": "string"
        },
        "playerId": {
          "pattern": "^[A-Z]{3}-\\d{2}$",
          "title": "Playerid",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "teamId": {
          "pattern": "^[A-Z]{3}$",
          "title": "Teamid",
          "type": "string"
        },
        "type": {
          "const": "CARD",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "wallClock": {
          "format": "date-time",
          "title": "Wallclock",
          "type": "string"
        }
      },
      "required": [
        "eventId",
        "matchId",
        "seq",
        "version",
        "clock",
        "wallClock",
        "teamId",
        "playerId",
        "type",
        "card",
        "foulEventId"
