{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "description": "A named editor's decision on an item before it goes on air.",
      "properties": {
        "decidedAt": {
          "format": "date-time",
          "title": "Decidedat",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "editor": {
          "pattern": "^[A-Z][A-Za-z.' -]{1,59}$",
          "title": "Editor",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "editor",
        "decidedAt",
        "decision"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Disclosure": {
      "additionalProperties": false,
      "description": "How AI involvement is shown on an item: the label (rendered by code, never by a model).",
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "mode": {
          "enum": [
            "label-all",
            "label-unless-approved",
            "eu-strict"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ai_generated",
            "ai_assisted_reviewed",
            "data"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "mode",
        "reason"
      ],
      "title": "Disclosure",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "eventIds": {
          "items": {
            "pattern": "^m[0-9]{1,12}-e[0-9]{4,9}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Eventids",
          "type": "array"
        },
        "metricSnapshotIds": {
          "items": {
            "maxLength": 96,
            "pattern": "^ms-m[0-9]{1,12}-[a-z_]{2,24}-([A-Z]{3}|match)-(5m|15m|match)-s[0-9]{4,9}-v[0-9]{1,4}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Metricsnapshotids",
          "type": "array"
        }
      },
      "required": [
        "eventIds",
        "metricSnapshotIds"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Who produced the insight and how: recorded for every published item.",
      "properties": {
        "agent": {
          "pattern": "^[a-z][a-z-]{1,31}$",
          "title": "Agent",
          "type": "string"
        },
        "model": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Model",
          "type": "string"
        },
        "producedBy": {
          "enum": [
            "model",
            "template"
          ],
          "title": "Producedby",
          "type": "string"
        },
        "promptVersion": {
          "pattern": "^v[0-9]{1,3}\\.[0-9]{1,3}$",
          "title": "Promptversion",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "promptVersion",
        "model",
        "producedBy"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceClaim": {
      "additionalProperties": false,
      "description": "A claim as the audience read it, and the evidence it rests on.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "ProvenanceClaim",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/SignedAttempt"
          },
          "maxItems": 99,
          "title": "Attempts",
          "type": "array"
        },
        "canonical": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ProvenanceClaim"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "corrections": {
          "items": {
            "pattern": "^c-m[0-9]{1,12}-[0-9]{2,4}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Corrections",
          "type": "array"
        },
        "disclosure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Disclosure"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedEntry": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Feedentry",
          "type": "integer"
        },
        "headline": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "insightId": {
          "maxLength": 72,
          "pattern": "^in-m[0-9]{1,12}-[a-z_]{2,24}-[A-Z]{3}-s[0-9]{4,9}-a[0-9]{1,2}$",
          "title": "Insightid",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "title": "Issuedat",
          "type": "string"
        },
        "issuer": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "itemId": {
          "maxLength": 128,
          "pattern": "^it-[a-z]+(-[a-z]+)*-[A-Za-z0-9_-]{1,100}$",
          "title": "Itemid",
          "type": "string"
        },
        "locale": {
          "enum": [
            "en-GB",
            "es-MX",
            "de-DE"
          ],
          "title": "Locale",
          "type": "string"
        },
        "localized": {
          "$ref": "#/$defs/Provenance"
        },
        "matchId": {
          "pattern": "^m[0-9]{1,12}$",
          "title": "Matchid",
          "type": "string"
        },
        "state": {
          "enum": [
            "on_air",
            "pending_approval",
            "rejected",
            "retracted",
            "amended"
          ],
          "title": "State",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^it-[a-z]+(-[a-z]+)*-[A-Za-z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "tenantId": {
          "enum": [
            "northlight-sport",
            "tribuna-austral",
            "rheinblick-sport"
          ],
          "title": "Tenantid",
          "type": "string"
        },
        "version": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "itemId",
        "tenantId",
        "matchId",
        "insightId",
        "version",
        "locale",
        "state",
        "issuer",
        "issuedAt",
        "feedEntry",
        "headline",
        "claims",
        "canonical",
        "localized",
        "attempts",
        "disclosure",
        "approval",
        "supersedes",
        "corrections"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "SignedAttempt": {
      "additionalProperties": false,
      "description": "An attempt as a record signs it: who drafted and how it ended. What the attempt cost is\noperations, not provenance, and stays out, so a record's signed bytes never change shape.",
      "properties": {
        "agent": {
          "pattern": "^[a-z][a-z-]{1,31}$",
          "title": "Agent",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "findings": {
          "items": {
            "enum": [
              "MOMENT_MISMATCH",
              "MALFORMED_INSIGHT",
              "UNSUPPORTED_CHARACTER",
              "BARE_NUMBER",
              "RAW_NAME",
              "UNVERIFIED_NAME",
              "UNKNOWN_WORD",
              "FUTURE_WORDING",
              "UNKNOWN_PLAYER",
              "UNKNOWN_CLUB",
              "PLAYER_NOT_IN_EVIDENCE",
              "MINUTE_NOT_IN_EVIDENCE",
              "SNAPSHOT_NOT_FOUND",
              "UNDEFINED_VALUE",
              "EVIDENCE_NOT_FOUND",
              "FUTURE_EVIDENCE",
              "FUTURE_MINUTE",
              "VOIDED_EVIDENCE",
              "SUPERSEDED_EVIDENCE",
              "CLAIMS_CHANGED",
              "REFERENCES_CHANGED",
              "BLOCKED_TOPIC",
              "TOO_LONG"
            ],
            "type": "string"
          },
          "maxItems": 64,
          "title": "Findings",
          "type": "array"
        },
        "model": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Model",
          "type": "string"
        },
        "number": {
          "maximum": 99,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "number",
        "agent",
        "model",
        "outcome",
        "findings",
        "error"
      ],
      "title": "SignedAttempt",
      "type": "object"
    }
  },
  "$id": "https://github.com/saguarocloud/fourth-official/schemas/signed-provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A record, the SHA-256 of its canonical bytes, and the studio's signature over that hash.",
  "properties": {
    "algorithm": {
      "enum": [
        "ES256",
        "HS256"
      ],
      "title": "Algorithm",
      "type": "string"
    },
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contenthash",
      "type": "string"
    },
    "keyId": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Keyid",
      "type": "string"
    },
    "record": {
      "$ref": "#/$defs/ProvenanceRecord"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]{8,700}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "record",
    "contentHash",
    "signature",
    "algorithm",
    "keyId"
  ],
  "title": "SignedProvenance",
  "type": "object"
}
