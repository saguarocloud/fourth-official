          "type": "string"
        },
        "clock": {
          "maxLength": 8,
          "minLength": 1,
          "title": "Clock",
          "type": "string"
        },
        "home": {
          "pattern": "^[A-Z]{3}$",
          "title": "Home",
          "type": "string"
        },
        "score": {
          "maxLength": 7,
          "minLength": 1,
          "title": "Score",
          "type": "string"
        },
        "template": {
          "const": "score_bug",
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template",
        "home",
        "away",
        "score",
        "clock"
      ],
      "title": "ScoreBug",
      "type": "object"
    },
    "StatCard": {
      "additionalProperties": false,
      "properties": {
        "rows": {
